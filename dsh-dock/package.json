{
  "name": "dsh-dock",
  "description": "Persistent balance dock + process control (restart/stop) for the dsh web GUI",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "balance",
    "token-usage",
    "restart",
    "stop"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./balance": "./lib/balance.js",
    "./usage": "./lib/usage.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/usage.js && node --check lib/balance.js && node --check lib/safe-fetch.js && node --check lib/claude.js && node --check lib/client.js"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT"
}
